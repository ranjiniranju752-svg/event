# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Email
# Development: leave EMAIL_BACKEND as the console backend so emails print in
# the terminal. Production: use the SMTP backend and real credentials.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ScentScope <no-reply@example.com>

# Account verification link lifetime (hours)
EMAIL_VERIFICATION_HOURS=24
